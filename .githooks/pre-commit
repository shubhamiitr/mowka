#!/usr/bin/env bash
# Auto-sync public/llms.txt and public/site.webmanifest from
# src/constants/content.js before every commit. If the sync changes
# anything, the updated files are staged automatically.

set -e

# Skip if no JS source for constants is staged or if the static files
# themselves are being deliberately edited alone.
if ! git diff --cached --name-only | grep -qE '^(src/constants/content\.js|scripts/sync-static\.mjs|public/llms\.txt|public/site\.webmanifest)$'; then
    exit 0
fi

echo "→ Syncing static files from constants…"
npm run --silent sync

git add public/site.webmanifest public/llms.txt
